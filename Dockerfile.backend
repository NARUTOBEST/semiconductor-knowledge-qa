# ============================================================
# 业务后端 :8001(FastAPI)—— 不跑 embedding 模型,无需 torch/GPU。
# 上下文为项目根;代码运行时把 server/ 与 config/ 等加入 sys.path
# (见 server/chat/__init__.py),故 WORKDIR=/app 即项目根。
# ============================================================
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_ENDPOINT=https://hf-mirror.com \
    HOST=0.0.0.0 \
    PORT=8001

WORKDIR /app

# 先装依赖(requirements 含 torch 行,后端不用,装时剔除以免拉 2GB+ CUDA 包)
COPY requirements.txt .
RUN grep -v -iE "^torch|FlagEmbedding|sentence-transformers" requirements.txt \
        > /tmp/req-backend.txt \
    && pip install -r /tmp/req-backend.txt

# 业务代码(数据/模型由卷挂载,见 .dockerignore)
COPY . .

EXPOSE 8001

# PG 就绪前后端也能启动(工作记忆降级内存、流水/升迁静默跳过),
# 但 compose 里仍用 depends_on 健康条件保证就绪顺序。
CMD ["python", "server/main.py"]
