# ============================================================
# 半导体设备知识问答系统 —— 项目机离线部署配置模板。
# 实际 .env 由 setup-env.sh 自动生成(密码随机、网关与令牌内置),无需手工编辑;
# 本文件仅作字段说明。
# 本机 = 前后端 + 存储(零模型);检索/LLM 在 GPU 机,经 SSH 反向隧道 127.0.0.1 访问。
# ============================================================

# ---- 安全密钥(setup-env.sh 自动随机生成)----
JWT_SECRET=<openssl rand -hex 32>
REDIS_PASSWORD=<openssl rand -hex 16>
POSTGRES_PASSWORD=<openssl rand -hex 16>
# 首个管理员引导令牌(注册第一个用户时请求头 X-Bootstrap-Token 与此一致则授 admin)
ADMIN_BOOTSTRAP_TOKEN=<openssl rand -hex 16>

# ---- LLM 网关(GPU 机 LiteLLM,经 SSH 反向隧道映射到本机 127.0.0.1:4000)----
# 必须与 GPU 机 .env 的 LITELLM_MASTER_KEY 同一串(两端 setup 脚本内置同一值)
LLM_GATEWAY_BASE_URL=http://127.0.0.1:4000/v1
LLM_GATEWAY_API_KEY=<your-litellm-master-key>
GATEWAY_MODEL_MAIN=main
GATEWAY_MODEL_LIGHT=light

# ---- 检索微服务(GPU 机,经隧道映射到本机 127.0.0.1:8002)----
RETRIEVAL_SERVICE_URL=http://127.0.0.1:8002
# 服务间鉴权 token,必须与 GPU 机检索服务的 RETRIEVAL_INTERNAL_TOKEN 一致
RETRIEVAL_INTERNAL_TOKEN=<same-as-ssh_helper/ret.env>

# ---- 云端兜底(GPU 机 vLLM 故障时 LiteLLM 自动回落;业务侧无需直接配置)----
OPENAI_API_KEY=<your-api-key>
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v1
OPENAI_TEXT_MODEL=deepseek-v4-flash

# ---- 图片对象存储(火山 TOS,检索结果图片签名链接;不需要图片展示可留空)----
TOS_ENDPOINT=tos-s3-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_KEY_PREFIX=qingxi

# ---- 对外端口 ----
WEB_PORT=3000
WEB_BIND=0.0.0.0
# Qdrant 只对本机开放(6333 不对外)
QDRANT_BIND=127.0.0.1
