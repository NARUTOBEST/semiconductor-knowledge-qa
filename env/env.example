# ===== OpenAI 兼容 API 配置 =====

# API 密钥
OPENAI_API_KEY=<your-api-key>

# API 基础地址(任意 OpenAI 兼容服务地址)
OPENAI_BASE_URL=<your-openai-compatible-base-url>

# 文本对话模型(支持 function-calling;作为 medium/complex 的默认模型)
OPENAI_TEXT_MODEL=<your-text-model-name>

# ===== 三级推理范式(复杂度路由)=====
# simple:单轮直答(无工具,lite 模型,快);medium:ReAct 检索循环;
# complex:Plan-and-Execute(必经规划 + 分步执行 + 综合)。
# 各 tier 模型留空时:SIMPLE 用 doubao-seed-2.0-lite,
# MEDIUM/COMPLEX 回退到 OPENAI_TEXT_MODEL(=deepseek-v4-flash)。
TIER_MODEL_SIMPLE=
TIER_MODEL_MEDIUM=
TIER_MODEL_COMPLEX=

# 各 tier 的 ReAct 轮数上限与总预算(秒);均可独立覆盖
TIER_SIMPLE_MAX_STEPS=1
TIER_SIMPLE_MAX_TOTAL_SECONDS=20
TIER_MEDIUM_MAX_STEPS=6
TIER_MEDIUM_MAX_TOTAL_SECONDS=60
# complex 的 MAX_STEPS 即检索计划步数上限(generate_plan max_steps)
TIER_COMPLEX_MAX_STEPS=4
TIER_COMPLEX_MAX_TOTAL_SECONDS=120
# medium 是否条件触发检索计划(1=条件启用,0=关闭);complex 始终规划
TIER_MEDIUM_PLAN_ENABLED=1

# 复杂度路由器:规则预筛 + lite LLM 分类(失败兜底 medium)
ROUTER_TIMEOUT=8                 # 分类 LLM 调用超时(秒)
ROUTER_CONFIDENCE_MIN=0.6        # 低于此置信度兜底 medium
ROUTER_SHORT_LEN=6               # 不超过该长度且无领域信号 -> 规则直接判 simple

# 多模态模型(支持图像理解 + 文本对话 + function-calling)
OPENAI_VISION_MODEL=<your-vision-model-name>

# 多模态调用附加参数:关闭 thinking 以节省 token
OPENAI_VISION_EXTRA={"thinking":{"type":"disabled"}}

# 嵌入模型设备(cpu 给 LLM 腾出 GPU / cuda)
EMBED_DEVICE=<cpu-or-cuda>

# ===== 服务安全配置(可选,不设则用默认值) =====

# 运行环境:dev(默认,保留 /docs 方便调试) / prod(关闭 /docs /redoc /openapi.json)
ENV=dev

# 监听地址:127.0.0.1(仅本机,默认) / 0.0.0.0(部署到服务器时用)
HOST=127.0.0.1

# 监听端口
PORT=8001

# CORS 允许源(逗号分隔);生产环境按实际前端地址配置
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 认证配置 =====
JWT_SECRET=<your-jwt-secret>
JWT_EXPIRE_HOURS=24

# ===== 瞬时记忆(工作记忆:请求级临时存储)=====
# 后端: memory(默认,单进程) / redis(多 worker 部署)
WORKING_MEMORY_BACKEND=memory
# Redis 后端 TTL(秒)与地址(仅 WORKING_MEMORY_BACKEND=redis 时生效)
WORKING_MEMORY_TTL_SECONDS=120
WORKING_MEMORY_REDIS_URL=redis://127.0.0.1:6379/0

# ===== 上下文管理 =====
# 工具结果回传 LLM 时的截断字符数(完整结果仍存在工作记忆中,可被 get_chunk 取)
CONTEXT_TOOL_RESULT_MAX_CHARS=800

# ===== Agent 记忆系统 (PostgreSQL 多库分表 + Redis 可选缓存)=====
# 三库独立,禁止跨库 join;每个库都需单独 CREATE EXTENSION vector。
# Python 在 Windows,PG/Redis 在 WSL2,经 127.0.0.1 端口转发访问。
# 风险:WSL2 重启后 netsh 端口转发失效需重建;生产勿依赖此方案。
WORKING_PG_URI=postgresql://<pg_user>:<pg_password>@127.0.0.1:5432/agent_working_db
SHORT_PG_URI=postgresql://<pg_user>:<pg_password>@127.0.0.1:5432/agent_short_db
LONG_PG_URI=postgresql://<pg_user>:<pg_password>@127.0.0.1:5432/agent_long_db

# Redis 仅作高速缓存预留,主存储为 PG,不强制强依赖
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>
REDIS_DB=0

# 升迁调优(可选,均有默认值)
# 守门员模型:萃取前判断本轮是否值得升迁,留空则复用 OPENAI_TEXT_MODEL
LONG_MEMORY_GATE_MODEL=
# 长期记忆语义去重阈值:写入前与同用户同类型既有记忆比对余弦相似度,>= 此值视为重复跳过(BGE-m3,默认 0.92)
LONG_MEMORY_DEDUP_THRESHOLD=0.92
