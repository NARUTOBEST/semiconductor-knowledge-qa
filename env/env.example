# ===== OpenAI 兼容 API 配置 =====

# API 密钥
OPENAI_API_KEY=<your-api-key>

# API 基础地址(任意 OpenAI 兼容服务地址)
OPENAI_BASE_URL=<your-openai-compatible-base-url>

# 文本对话模型(支持 function-calling;偏复杂任务:medium/complex 推理、grounding、事实萃取)
OPENAI_TEXT_MODEL=<your-text-model-name>

# 简单/轻量任务模型(分类、query 改写、摘要、长句切分、升迁守门);留空用内置 doubao-seed-2.0-lite
MODEL_LIGHT=doubao-seed-2.0-lite

# ===== 可拔插 LLM 网关(租用 GPU 服务器自建 vLLM/LiteLLM,见 gateway/README.md)=====
# 配置 BASE_URL 后:所有 LLM 走自建网关(自有算力不限流),自动关闭经济模式、全功能开启;
# 留空(缺省):回退上方云端账号,并自动进入【经济模式】——关闭下列旁路 LLM 以把每次
# 请求的调用数砍到最少(只保留面向用户作答的核心调用)。换 GPU 服务器只改 BASE_URL。
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
# 网关上的逻辑模型名(由 LiteLLM 映射到具体模型);一般保持默认
GATEWAY_MODEL_MAIN=main
GATEWAY_MODEL_LIGHT=light

# 经济模式:auto(默认,无网关即开/有网关即关);也可强制 1 开 / 0 关
ECONOMY_MODE=auto
# 经济模式下默认关闭的旁路 LLM,可单独强制(1 开 / 0 关):
#ROUTER_LLM_ENABLED=1          # 复杂度分类 LLM(关→纯规则,未命中兜底 react)

# ===== 三级推理范式(复杂度路由)=====
# L1 simple  :日常闲聊/元问题,单轮直答(无工具,lite 模型,快);
# L2 raglite :单一事实点快路径,1 次检索 + 1 次主模型流式作答(不走 ReAct 循环);
# L3 react   :复杂知识问答,ReAct 检索循环(检索三件套),无任何旁路 LLM。
# raglite 对外 tier 事件仍报 "react"(附 path=raglite),eval/前端零改动。
# 模型留空时:SIMPLE 用 doubao-seed-2.0-lite,REACT 回退 OPENAI_TEXT_MODEL。
TIER_MODEL_SIMPLE=
TIER_MODEL_REACT=

# 各 tier 的轮数上限与总预算(秒);均可独立覆盖
TIER_SIMPLE_MAX_STEPS=1
TIER_SIMPLE_MAX_TOTAL_SECONDS=20
TIER_REACT_MAX_STEPS=2              # 知识问答:1 次工具步 + 1 次强制作答
TIER_REACT_MAX_TOTAL_SECONDS=40

# ---- raglite 快路径(单一事实点)----
RAGLITE_ENABLED=1
RAGLITE_MAX_TOTAL_SECONDS=25        # 单次执行时长预算
RAGLITE_MAX_QUESTION_LEN=60         # 超长问题不走快路(交 react)
RAGLITE_SEARCH_K=5                  # 检索条数(sources 事件用)
RAGLITE_SEARCH_SCORE_RATIO=0.4
RAGLITE_PROMPT_CHUNKS=3             # 喂给模型的前几块(控制 prefill)
RAGLITE_CHUNK_CHARS=800             # 每块截断字符
RAGLITE_ANSWER_MAX_TOKENS=512       # 答案解码上限
RAGLITE_SPECULATIVE_SEARCH=1        # 与路由分类重叠预发 search_text

# ---- 融合入口 / 质检 / 终答解码 ----
ROUTER_FUSED=1                      # clarify+router 合并为单次 light 调用
LLM_ENABLE_THINKING=0               # 0=全链路关 Qwen3 思考模式(省 3~8s/次);1=恢复思考
QC_LOW_CONF_REDO=0                  # 0=低置信放行+警告;1=整轮 redo(旧行为,+12s)
REACT_ANSWER_MAX_TOKENS=600         # react 终答解码上限(工具调用步不设限)
#REACT_PRE_SEARCH=1                 # react 首轮注入投机检索结果(0 关闭)

# 复杂度路由器:规则预筛 + lite LLM 分类(失败兜底 react)
ROUTER_TIMEOUT=8                 # 分类 LLM 调用超时(秒)
ROUTER_CONFIDENCE_MIN=0.6        # 低于此置信度兜底 react
ROUTER_SHORT_LEN=6               # 不超过该长度且无领域信号 -> 规则直接判 simple

# 澄清反问:路由前判定问题是否缺少关键实体(设备/型号/指代无法消解),命中则先反问
CLARIFY_ENABLED=1                # 0/false 关闭澄清判定
CLARIFY_TIMEOUT=8                # 澄清判定 LLM 调用超时(秒)

# 视觉模型(火山方舟 Doubao-Seed-2.0-mini 推理点):入库管线用它生成清洗图片描述。
# BASE_URL 与对话模型不同(推理点走 /api/v3);API key 留空则回退通用 OPENAI_API_KEY。
OPENAI_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_VISION_MODEL=ep-20260728200449-fntbv
# OPENAI_VISION_API_KEY=

# 视觉模型调用附加参数:关闭 thinking 以节省 token
OPENAI_VISION_EXTRA={"thinking":{"type":"disabled"}}

# ===== 熔断器(按工具维度)=====
CIRCUIT_BREAKER_ENABLED=1          # 0=关闭熔断
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5   # 连续失败达该阈值则熔断(FATAL 不计入)
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30   # 熔断后半开试探的冷却秒数

# 同一轮 ReAct 内多个无依赖工具调用的并发上限(线程池 fan-out);1=串行
TOOL_MAX_PARALLEL=4

# 工具故障自适应:熔断/本轮故障的工具从 schema 摘除并在 system 提示告知替代策略(0=关闭)
TOOL_HEALTH_ADAPT_ENABLED=1

# 嵌入模型设备(cpu 给 LLM 腾出 GPU / cuda)
EMBED_DEVICE=<cpu-or-cuda>

# ===== 服务安全配置(可选,不设则用默认值) =====

# 运行环境:dev(默认,保留 /docs 方便调试) / prod(关闭 /docs /redoc /openapi.json)
ENV=dev

# 监听地址:127.0.0.1(仅本机,默认) / 0.0.0.0(部署到服务器时用)
HOST=127.0.0.1

# 监听端口
PORT=8001

# CORS 允许源(逗号分隔);生产环境按实际前端地址配置
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 认证配置 =====
JWT_SECRET=<your-jwt-secret>
# 首个管理员引导令牌:注册第一个用户时请求头 X-Bootstrap-Token 须与此值一致才授予 admin;
# 不配置则所有自助注册均为普通用户(杜绝抢先注册提权)。创建管理员后可停用。
ADMIN_BOOTSTRAP_TOKEN=
JWT_EXPIRE_HOURS=24

# ===== 瞬时记忆(工作记忆:请求级临时存储)=====
# 后端: memory(默认,单进程) / redis(多 worker 部署)
WORKING_MEMORY_BACKEND=memory
# Redis 后端 TTL(秒)与地址(仅 WORKING_MEMORY_BACKEND=redis 时生效)
WORKING_MEMORY_TTL_SECONDS=120
WORKING_MEMORY_REDIS_URL=redis://127.0.0.1:6379/0

# ===== 上下文管理 =====
# 工具结果回传 LLM 时的截断字符数(完整结果仍存在工作记忆中,可被 get_chunk 取)
CONTEXT_TOOL_RESULT_MAX_CHARS=800

# ===== Agent 记忆系统(工作记忆 + 短期记忆均用 Redis)=====
#   工作记忆 = LangGraph checkpoint(RedisSaver);短期记忆 = 会话事件流水(mem:* 键)。
#   长期记忆在 Qdrant;PostgreSQL 已不再用于记忆(WORKING/SHORT_PG_URI 废弃,留空即可)。
#
# 本地开发(Windows):Redis 跑在 WSL2,Windows 侧经 127.0.0.1:6379 访问。
#   WSL2 内启动 Redis(任选其一):
#     sudo apt update && sudo apt install -y redis-server && sudo service redis-server start
#     # 或: docker run -d --name redis -p 6379:6379 redis:7-alpine
#   WSL2 默认 localhost 转发即可;若不通再按 `wsl hostname -I` 的 IP 做 netsh portproxy
#   (netsh interface portproxy add v4tov4 listenport=6379 ... connectaddress=<WSL_IP>),
#   WSL2 重启后转发规则可能失效需重建。
# Ubuntu Server / docker-compose:compose 内置 redis 服务,REDIS_HOST=redis(见 docker-project)。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password;无密码留空>
REDIS_DB=0
# 可选:显式连接 URL(给 RedisSaver);不填则由上面 host/port/password/db 自动拼出
#REDIS_URL=redis://:<redis-password>@127.0.0.1:6379/0
# 短期记忆流水滚动 TTL(天),默认 30
#MEMORY_TTL_DAYS=30

# ===== 工作流追踪记录(trace 包;独立 Redis 键空间 trace:*,供测试/运维复查)=====
# 与短期对话记忆分离:短期只存 user/assistant 问答喂模型;追踪存 tool_call/
# tool_result/error/error_trace/done(含完整 trace),事后复查,不回喂模型。
# 旁路写:Redis 不可用只降级、不影响聊天。
#TRACE_STORE_ENABLED=1          # 置 0/false 关闭追踪落库
#TRACE_TTL_DAYS=14              # 追踪键滚动 TTL(天),默认 14
#TRACE_MAX_PAYLOAD_CHARS=20000  # 单条事件 payload 上限(字符),超长截断防膨胀
# 兜底:先重试、再熔断(开路冷却、半开探测恢复);全程旁路不阻断聊天
#TRACE_RETRY_MAX=3              # 单条操作最多尝试次数(含首次),瞬时故障指数退避重试
#TRACE_RETRY_BACKOFF=0.05       # 重试退避基数(秒,指数 2^n)
#TRACE_CIRCUIT_COOLDOWN=30      # 重试用尽后熔断开路冷却(秒),期内追踪操作直接跳过

# ===== 长期记忆(用户个人偏好;PostgreSQL + pgvector,按 user 哈希分表)=====
# 旁路增强:不配置 / 连不上 PG 时自动降级,不抽取、不注入,聊天不受影响。
# WSL2 起一个带 pgvector 的 Postgres,并建库 memory_long:
#   docker run -d --name pg-mem -e POSTGRES_PASSWORD=<pg-password> \
#     -e POSTGRES_DB=memory_long -p 5432:5432 pgvector/pgvector:pg16
# 建表(幂等):python -m memories.db.init_all
LONG_MEM_ENABLED=1
# 二选一:给完整连接串,或给下面 POSTGRES_* 由程序拼接
#LONG_PG_URI=postgresql://postgres:<pg-password>@127.0.0.1:5432/memory_long
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=memory_long
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<pg-password>
# 分表数(按 blake2b(username) 取模落 long_mem_00..N-1);改值需重建表,默认 16
#LONG_MEM_SHARD_COUNT=16
# 每轮注入的语义相关偏好条数,默认 5
#LONG_MEM_TOP_K=5
# 无 key 偏好的向量近邻去重相似度阈值(0~1),默认 0.9
#LONG_MEM_DUP_COSINE=0.9

# ===== 短期记忆工作闭环(memory-loop:后台独立记忆图,答案定稿后异步执行)=====
# 闭环总开关(默认 1);旁路 LLM 在经济模式(无网关)下默认关闭。
# 编排:主图 finalize→done 即完即关;每轮答案后由后台管道跑独立记忆图(同会话串行),
# 下一轮请求入口最多等 MEM_WAIT_IDLE_TIMEOUT 秒让上一轮记忆处理完(超时放行)。
#MEM_LOOP_ENABLED=1
# —— 入口等待门 ——
#MEM_WAIT_IDLE_TIMEOUT=10.0        # 下一轮最多等上一轮记忆链的秒数(超时放行)
# —— 存储节点:短期事实表(Redis,前缀 memf:,与事件流水分离)——
#MEM_FACT_TTL_SECONDS=86400        # TTL 24h
#MEM_FACT_MAX_PER_THREAD=10000     # 容量上限(超限按 重要度+最近访问 淘汰)
#MEM_FACT_SEMANTIC_DEDUP=0         # 1=embedding 语义去重(默认关,用规范化指纹)
#MEM_FACT_DUP_COSINE=0.9
# —— 存储节点:升迁门(LLM 判定是否升迁长期记忆;PG 宕机自动走本地 spool,恢复重放)——
#MEM_PROMOTE_ENABLED=1             # 经济模式默认关
#MEM_PROMOTE_IMPORTANCE=0.6
#MEM_RETRY_MAX=2                   # 升迁门失败最多重试(持续故障由熔断器跨任务兜底)
#MEM_RETRY_MAX_SLEEP=2.0           # 指数退避上限(秒)
#MEM_BREAKER_FAIL_THRESHOLD=3      # 连续失败达阈值熔断
#MEM_BREAKER_COOLDOWN=300          # 熔断冷却(秒)
#MEM_GATE_LLM_TIMEOUT=6.0          # 升迁门单模型超时(主模型失败自动切备用模型)
# —— 记忆欠账补做 spool(与短期 WAL 同目录 turn_work.spool.jsonl)——
# Redis 宕机期的事实表欠账 + 升迁门 LLM 宕机期的判定欠账,恢复后每轮有界补跑
# 完整沉淀(去重/升迁/落库);开关/体积/落盘复用 MEM_SPOOL_ENABLED/FSYNC/MAX_MB。
#MEM_WORK_SPOOL_DRAIN_LIMIT=3      # 每轮补做条数(每条可能调一次升迁门 LLM,刻意收紧)
#MEM_WORK_SPOOL_DRAIN_BUDGET=8.0   # 每轮补做时间盒(秒)
#MEM_WORK_SPOOL_DRAIN_ENABLED=1    # 置 0 关闭补做(欠账保留不删)
# —— 摘要压缩节点:session-memory.md + Auto-Compact(阈值不满足零成本早退)——
#MEM_SESSION_DIR=                 # 默认 <项目根>/memories_data/sessions
#MEM_SESSION_MAINT_LOCK_TIMEOUT=30  # 同会话摘要整周期文件锁等待上限(秒);超时本轮不摘要(降级)
#MEM_SUMMARY_FIRST_TOKENS=10000
#MEM_SUMMARY_UPDATE_TOKEN_TOOL=5000
#MEM_SUMMARY_UPDATE_TOOL_CALLS=3
#MEM_SUMMARY_UPDATE_TOKEN_TEXT=2000
#MEM_MODEL_CONTEXT_TOKENS=40960
#MEM_COMPACT_RESERVE_MIN=13000
#MEM_COMPACT_RESERVE_RATIO=0.10
#MEM_KEEP_RECENT_DEFAULT=20000    # compact 保留原文(10000~40000)
#MEM_MIN_TEXT_MESSAGES=5
#MEM_RULE_KEEP_TURNS=6
#MEM_SUMMARY_LLM_TIMEOUT=8.0
#MEM_SUMMARY_LLM_RETRIES=2
#MEM_SUMMARY_MAX_CHARS=4000

# ===== 图片对象存储(火山引擎 TOS,S3 兼容;私有桶 + 时效签名链接)=====
# 检索结果里的图片本地绝对路径会实时签名为 HTTPS 链接,前端/视觉模型直接取图,
# 部署虚拟机无需复制 D:\清洗文件。四项(ENDPOINT/REGION/BUCKET/AK/SK)配齐才启用,
# 全留空则检索结果回退返回本地绝对路径(本地开发兼容)。
# 开通:火山引擎控制台 -> 对象存储 TOS -> 创建桶(私有) -> 密钥管理创建 AccessKey。
# 注意:必须用 S3 兼容端点 tos-s3-<region>.volces.com(不是原生 tos-<region>.volces.com)
TOS_ENDPOINT=tos-s3-cn-beijing.volces.com   # S3 兼容端点(上海为 tos-s3-cn-shanghai.volces.com)
TOS_REGION=cn-beijing                    # 地域 ID
TOS_BUCKET=                              # 桶名
TOS_ACCESS_KEY=                          # AccessKey ID
TOS_SECRET_KEY=                          # SecretAccessKey
TOS_URL_EXPIRES=3600                     # 签名链接有效期(秒)
TOS_KEY_PREFIX=qingxi                    # 桶内对象 key 前缀
TOS_USE_PATH_STYLE=0                     # TOS 用 0(虚拟主机风格);自建 MinIO 设 1
# 图片文件在本机的根目录(payload 路径前缀,签名时据此换算对象 key)
CLEAN_FILES_ROOT=D:\清洗文件
# 一次性上传图片到桶(断点续传):  .venv_mineru\Scripts\python.exe _tos_upload.py

# ==================== MCP 工具桥 ====================
# agent 作为 MCP Client 连接的外部工具服务(tools/mcp_bridge.py 读取)。
# 缺省连本地检索服务的 /mcp;JSON 数组,每项 {name, url} 或 {name, module}(进程内直连,测试用)。
# 可选 name_prefix 给工具名加前缀防多 server 撞名;MCP_CONNECT_TIMEOUT_S(默认3,0=启动不等)、
# MCP_RETRY_INTERVAL_S(默认10,连接失败后台重试间隔)。
#MCP_SERVERS=[{"name": "retrieval", "url": "http://127.0.0.1:8002/mcp"}]

# ==================== 检索推理吞吐(:8002 进程内) ====================
# 按模型各持一把推理锁(BGE-m3 编码/CLIP/重排互不排队);encode 并发经单飞批
# 攒批合并。以下均可环境变量覆盖:
# 攒批窗口毫秒:越大合并率越高、单请求延迟略增(默认 20;高峰可调 30)
#RETRIEVAL_ENCODE_WINDOW_MS=20
# 单飞批单批上限,超上限切分(默认 16)
#RETRIEVAL_ENCODE_MAX_BATCH=16
# 入库让路:批量(入库)编码在批与批之间发现在线单条请求排队时,退避毫秒再继续
# (在线请求最多等一小批;0=不让路)
#RETRIEVAL_INGEST_YIELD_MS=50
# 双实例隔离:入库用独立 BGE-m3/CLIP 副本 + 独立推理锁,与在线查询完全并行,
# 入库不再阻塞用户提问(模型内存约 ×2;离线副本懒加载,从未入库不占用)。
# 0=退回单实例,靠入库让路兜底隔离。
#RETRIEVAL_DUAL_ENCODER=1
# fp16:BGE-m3/reranker/CLIP 在 EMBED_DEVICE=cuda 时自动启用,无需配置。

# ==================== 检索漏斗与动态截断 ====================
# 召回池(dense/sparse 各 N -> RRF 融合):加宽漏斗换召回率,重排负责精筛
#RECALL_POOL=80
# 送入重排的候选数(召回池 -> 重排)
#RERANK_RECALL_K=32
# 重排后动态截断:score>=RERANK_TAU 保留,cap MAX_K,floor MIN_K(保底 top-1)
# RERANK_TAU 按线束分布校准(heading_path 进重排文本后需复扫)
#RERANK_TAU=0.4  # 2026-09-12 复扫定值(heading_path 进重排后)
#RERANK_MAX_K=6
#RERANK_POOL_MIN=8  # ratio 过滤后重排池保底(RRF 分 Top-Heavy,防压死重排池)
#RERANK_MIN_K=3   # 保底 3 块(不足时补 top3),避免 P@3 分母固定 3 被压低

# ==================== 服务间鉴权(检索微服务 :8002) ====================
# 非空时,检索微服务所有端点(除 /health)要求请求头 X-Internal-Token 与此值一致,
# 否则 403;主服务/MCP桥/embed_http/长期记忆嵌入/admin上传流水线 自动携带同值。
# 留空 = 鉴权关闭(本地开发默认)。生产/容器部署务必设置并配合 RETRIEVAL_HOST 收口。
#RETRIEVAL_INTERNAL_TOKEN=change-me-to-a-long-random-secret

# ==================== 运行态外置存储(限流/指标/admin任务态) ====================
# 限流(server/support/ratelimit.py)、指标(metrics.py)、admin 上传任务态
# (admin/pipeline.py)统一外置 Redis(与短期/工作记忆同一实例),多 worker
# 共享一致状态、应用重启不丢。Redis 不可用时按【熔断器】降级:CLOSED 内先快速
# 重试(连续失败达阈值才跳闸),OPEN 持续降级走内存,冷却后半开探测,成功自愈。
# "memory" 强制内存(测试用);默认 "redis"。
#RUNTIME_STATE_BACKEND=redis
# 连续失败多少次跳闸 OPEN(默认 3;失败间隔超过窗口则重新计数)
#RUNTIME_STATE_TRIP_THRESHOLD=3
# CLOSED 内单次失败后的快速重试窗口秒数(窗口内走内存,过后自动重试 Redis)
#RUNTIME_STATE_RETRY_COOLDOWN=2
# OPEN 降级持续秒数,冷却后半开探测一次:成功自愈 CLOSED,失败继续降级
#RUNTIME_STATE_OPEN_COOLDOWN=30
# 连续失败计数窗口秒数(两次失败间隔超过此值视为已恢复,计数清零)
#RUNTIME_STATE_STREAK_WINDOW=60
# 限流槽位 TTL(秒):须大于单请求最长耗时;worker 崩溃未释放时到期自动回收
#RATE_LIMIT_SLOT_TTL=600
# 运行指标/上传任务键的保留天数(滚动清理,写入续期)
#METRICS_TTL_DAYS=7
#ADMIN_TASK_TTL_DAYS=7

# ==================== 多 worker 部署(可选) ====================
# 后端进程数,默认 1(行为与单进程完全一致)。>1 时限流/指标/任务态走 Redis
# 共享;prune 清理由值班锁选主仅一个 worker 执行;检索微服务(:8002)仍须单进程。
#WORKERS=1
# 工作记忆降级 SQLite 文件位置(Redis 不可用时的二级降级 checkpointer,默认
# <项目根>/data/working_degrade.sqlite3;单机多 worker 共享此文件,会话不失忆)
#WORKING_DEGRADE_DB=
